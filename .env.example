# Веб-сервер (опционально)
# WEB_HOST=0.0.0.0
# WEB_PORT=8000

# LLM (AITUNNEL — OpenAI-совместимый прокси DeepSeek и др.)
# Ключ создаётся в кабинете aitunnel.ru, формат sk-aitunnel-...
DEEPSEEK_API_KEY=sk-aitunnel-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Провайдер AITUNNEL — НЕ указывать api.deepseek.com!
LLM_BASE_URL=https://api.aitunnel.ru/v1
# Название модели — из каталога AITUNNEL (/v1/models), например deepseek-chat
LLM_MODEL=deepseek-chat

# Расписание ежедневного автосбора (МСК)
TRENDS_TIME=09:00

# Прокси для внешних запросов (sing-box на хосте, 127.0.0.1:8080).
# При network_mode: "host" из контейнера виден 127.0.0.1 хоста,
# host.docker.internal НЕ использовать — он не резолвится в host-режиме.
# Пустое значение (PROXY_URL=) или отсутствие переменной — прямое подключение.
PROXY_URL=http://127.0.0.1:8080

# База данных (опционально)
# DB_PATH=/app/db/bot.db
