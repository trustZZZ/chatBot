# Telegram
BOT_TOKEN=токен_от_botfather
CHANNEL_ID=-100xxxxxxxxxx
ADMIN_ID=твой_chat_id

# LLM (DeepSeek)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Расписание (по МСК)
TRENDS_TIME=09:00

# Прокси для Telegram API (sing-box на хосте, 127.0.0.1:8080).
# При network_mode: "host" из контейнера виден 127.0.0.1 хоста,
# host.docker.internal НЕ использовать — он не резолвится в host-режиме.
# Пустое значение (PROXY_URL=) или отсутствие переменной — прямое подключение.
# При старте бот проверяет доступность Telegram (getMe, до 10 сек): если через
# прокси не проходит — автоматически переключается на прямое подключение.
# PROXY_URL=http://127.0.0.1:8080
