# Telegram
BOT_TOKEN=токен_от_botfather
CHANNEL_ID=-100xxxxxxxxxx
ADMIN_ID=твой_chat_id

# LLM (DeepSeek)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Расписание (по МСК)
TRENDS_TIME=09:00

# Опциональный прокси для Telegram API (например, для регионов с блокировками).
# Если не задан — бот работает напрямую. Если задан — проверяется при старте (5 сек),
# при недоступности бот автоматически переключается на прямое подключение.
# PROXY_URL=http://127.0.0.1:8080
